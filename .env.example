# ==============================================================
# StockSense Authentication Module - Environment Configuration
# ==============================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your real '.env' file to GitHub or version control.

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=stocksense

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_random_key_change_in_production
JWT_EXPIRES_IN=1d
JWT_RESET_EXPIRES_IN=15m

# Gmail SMTP Configuration for Password Reset OTPs
# NOTE: Use a Google App Password (16 characters), NOT your regular Gmail password.
# How to get it: Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Client URL (for CORS allowance)
CLIENT_URL=http://localhost:5173
